# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/siabsen
# Set to true jika koneksi ke database managed (mis. Neon/Supabase) memerlukan SSL
DATABASE_SSL=false

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# Model dipanggil lewat Converse API sehingga kompatibel lintas model.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# JWT (WAJIB) — gunakan string acak panjang, jangan commit nilai aslinya.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_secret_acak_yang_panjang
JWT_EXPIRES_IN=8h
