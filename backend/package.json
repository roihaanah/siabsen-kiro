{
  "name": "siabsen-backend",
  "version": "0.1.0",
  "description": "Backend API sistem absensi siswa",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node-pg-migrate -j js -m migrations",
    "migrate:up": "node-pg-migrate up -j js -m migrations",
    "migrate:down": "node-pg-migrate down -j js -m migrations",
    "migrate:create": "node-pg-migrate create -j js -m migrations",
    "seed": "node db/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.658.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.6.1"
  }
}
